# Copy to .env.local and fill in. Never commit real values.

# --- Database (Neon) ---
# Neon dashboard -> your project -> Connection string (pooled)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- App auth (Better Auth) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Encryption for stored platform tokens/cookies (AES-256-GCM) ---
# 32 random bytes, base64. Generate with the same command as above. Rotating it
# invalidates stored credentials (users will be asked to reconnect).
ENCRYPTION_KEY=

# --- Yahoo (Phase 2) ---
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=https://localhost:3000/api/yahoo/callback

# --- ESPN ---
# The app needs no ESPN config: public leagues use just a league ID, and users
# paste their espn_s2 / SWID cookies in the Connect ESPN screen for private ones.
# These two are ONLY for scripts/fetch-espn.ts during development:
ESPN_S2=
ESPN_SWID=
